#!name=自定义规则（iOS）
#!desc=集中维护 Surge iOS 的个人规则覆盖，按应用或服务分组管理。
#!system=ios

[General]
# Network stability
dns-server = system, 223.5.5.5, 1.1.1.1
ipv6 = false
ipv6-vif = disabled

[Rule]
# Xiaohongshu / RedNote
DOMAIN-SUFFIX,xiaohongshu.com,DIRECT,extended-matching
DOMAIN-SUFFIX,xhscdn.com,DIRECT,extended-matching
DOMAIN-SUFFIX,rednotecdn.com,DIRECT,extended-matching
DOMAIN,gslb.rnote.com,DIRECT,extended-matching

# Amap
DOMAIN,amap-aos-info-nogw.amap.com,REJECT
DOMAIN,optimus-ads.amap.com,REJECT
DOMAIN,awaken.amap.com,REJECT

# WeChat
DOMAIN-SUFFIX,wechat.com,DIRECT,extended-matching
DOMAIN-SUFFIX,weixin.qq.com,DIRECT,extended-matching
DOMAIN-SUFFIX,wx.qq.com,DIRECT,extended-matching
DOMAIN-SUFFIX,qpic.cn,DIRECT,extended-matching
DOMAIN-SUFFIX,qlogo.cn,DIRECT,extended-matching

[Map Local]
# Amap startup ad response
^https?:\/\/m5\.amap\.com\/ws\/shield\/dsp\/app\/startup\/init\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% m5.amap.com
